<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="90dp"
    android:paddingBottom="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FreshTrack"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/home_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="Track your products and never miss an expiry date."
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeLogin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="120dp"
        android:backgroundTint="@color/green_primary"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/background_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeSignup"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/card_dark"
        android:text="Sign up"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:strokeColor="@color/green_primary"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvContinueGuest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:text="Continue as guest"
        android:textColor="@color/green_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>