<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- IMAGE -->
    <ImageView
        android:id="@+id/imageToProcess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- CROP OVERLAY -->
    <com.freshtrack.ocr.ui.CropOverlayView
        android:id="@+id/cropOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- CONFIRM BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Confirm crop"
        app:backgroundTint="#52675C"
        app:tint="@android:color/white"
        app:srcCompat="@android:drawable/ic_menu_send"
        app:elevation="6dp" />

    <!-- MANUAL DATE ENTRY -->
    <LinearLayout
        android:id="@+id/manualEntryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="#E6000000">

        <EditText
            android:id="@+id/etManualText"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Or type the date manually..."
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@android:color/white"
            android:textColorHint="#BDBDBD"
            android:textSize="15sp"
            android:backgroundTint="#D0D0D0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseManualText"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:text="Use"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#42605C"
            app:cornerRadius="12dp"
            app:elevation="2dp" />

    </LinearLayout>

</FrameLayout>