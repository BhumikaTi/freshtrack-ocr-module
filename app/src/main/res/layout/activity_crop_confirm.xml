<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ImageView
        android:id="@+id/imageToProcess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:contentDescription="Image to process" />

    <com.freshtrack.ocr.ui.CropOverlayView
        android:id="@+id/cropOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rotate -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnRotate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:contentDescription="Rotate image"
        app:backgroundTint="@color/neon_green"
        app:tint="@color/background_dark"
        app:srcCompat="@android:drawable/ic_menu_rotate" />

    <!-- Optional crop -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="Crop"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:minHeight="52dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:backgroundTint="@color/neon_green"
        app:cornerRadius="26dp"
        android:textColor="@color/background_dark" />

    <!-- Confirm -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Scan image"
        app:backgroundTint="@color/neon_green"
        app:tint="@color/background_dark"
        app:srcCompat="@android:drawable/ic_menu_send" />

</FrameLayout>