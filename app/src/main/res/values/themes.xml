<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main FreshTrack App Theme -->
    <style name="Theme.OcrTest" parent="Theme.MaterialComponents.NoActionBar">

        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorSurface">@color/surface_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:colorAccent">@color/green_primary</item>

        <item name="colorOnSurface">@color/text_primary</item>

    </style>


    <!-- Light Date Picker Theme -->
    <style name="Theme_FreshTrack_DatePicker"
        parent="Theme.MaterialComponents.Light.Dialog.Alert">

        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorAccent">@color/green_primary</item>

        <item name="android:colorAccent">@color/green_primary</item>

        <item name="android:windowBackground">@color/card_dark</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

    </style>

</resources>